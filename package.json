{
  "name": "byte-quest",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.18.0",
      "lucide-react": "^1.41.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@orpc/server": "^1.15.0",
      "@orpc/client": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "1.7.5",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run db:start && bun run db:migrate && nx run-many -t dev",
    "build": "nx run-many -t build",
    "check-types": "nx run-many -t check-types",
    "test": "nx run-many -t test",
    "dev:web": "bun run db:start && bun run db:migrate && nx run-many -t dev --projects=web",
    "db:push": "nx run-many -t db:push --projects=@byte-quest/db",
    "db:studio": "nx run-many -t db:studio --projects=@byte-quest/db",
    "db:generate": "nx run-many -t db:generate --projects=@byte-quest/db",
    "db:migrate": "nx run-many -t db:migrate --projects=@byte-quest/db",
    "db:start": "docker compose up -d pg",
    "db:watch": "docker compose up pg",
    "db:stop": "docker compose stop pg",
    "db:down": "docker compose down pg",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && bun run auth:generate",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@byte-quest/config": "workspace:*",
    "@types/node": "^26.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nx": "^23.2.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "catalog:",
    "ultracite": "7.12.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
