# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url @sensitive={preventLeaks=false}
BETTER_AUTH_URL=

# Public origin used for canonical URLs, sitemap.xml and robots.txt.
# @public @optional @type=url
SITE_URL=

# @optional @type=string
DATABASE_URL=

# @optional @type=string
TURSO_DATABASE_URL=

# @optional @type=string
TURSO_AUTH_TOKEN=

# @type=string(minLength=8) @sensitive={preventLeaks=false}
ADMIN_PASSWORD=

# @optional @type=string
ADMIN_NAME=

# @optional @type=string
ADMIN_EMAIL=

# Outbound mail (packages/api/src/lib/mail.ts). Unset means the console
# transport in development and test; production refuses every send without a
# real transport, so configure smtp there.
# @public @optional @type=enum(console, smtp)
MAIL_TRANSPORT=

# Sender, e.g. "BYTE QUEST <no-reply@example.lk>". Required by smtp.
# @public @optional @type=string(minLength=3)
MAIL_FROM=

# SMTP host of the mailbox's outgoing server.
# @optional @type=string(minLength=1) @sensitive={preventLeaks=false}
SMTP_HOST=

# @public @optional @type=number(min=1, max=65535, isInt=true)
SMTP_PORT=587

# Mailbox username, usually the full address. Omit with SMTP_PASS only for an
# unauthenticated relay.
# @optional @type=string(minLength=1) @sensitive={preventLeaks=false}
SMTP_USER=

# @optional @type=string(minLength=1)
SMTP_PASS=

# "true" for implicit TLS (port 465). Unset/"false" for STARTTLS on 587.
# @public @optional @type=string
SMTP_SECURE=

# @public @optional @type=string
SMTP_ALLOW_SELF_SIGNED=

# Operator who gets an email each time the server starts. Unset sends nothing.
# @optional @type=string(minLength=3)
OPERATOR_ALERT_EMAIL=
