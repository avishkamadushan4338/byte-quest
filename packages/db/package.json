{
  "name": "@byte-quest/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b",
    "db:push": "varlock run -- drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "bun scripts/migrate-if-configured.ts",
    "db:studio": "varlock run -- drizzle-kit studio",
    "db:migrate": "varlock run -- bun scripts/migrate-if-configured.ts",
    "db:seed": "varlock run -- bun run scripts/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "catalog:",
    "ws": "^8.18.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@byte-quest/config": "workspace:*",
    "@types/ws": "^8.5.14",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
